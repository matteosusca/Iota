# Environment variables for KaizenFit

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=kaizenfit

# API Configuration
PORT=3000
NODE_ENV=development

# Prisma Database URL
# Uses variables above to build the connection string
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@database:5432/${POSTGRES_DB}?schema=public
