generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  coins            Int               @default(0)
  streakFreezes    Int               @default(0)
  currentStreak    Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  dailyLogs        DailyLog[]
  routineExercises RoutineExercise[]
  dailySummaries   DailySummary[]
}

model Exercise {
  id               String            @id @default(uuid())
  name             String
  type             String
  createdAt        DateTime          @default(now())
  dailyLogs        DailyLog[]
  routineExercises RoutineExercise[]
}

model RoutineExercise {
  id            String   @id @default(uuid())
  userId        String
  exerciseId    String
  targetMetrics Json
  createdAt     DateTime @default(now())
  exercise      Exercise @relation(fields: [exerciseId], references: [id])
  user          User     @relation(fields: [userId], references: [id])
}

model DailyLog {
  id         String   @id @default(uuid())
  userId     String
  exerciseId String
  date       DateTime
  status     String
  metrics    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
}

model DailySummary {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime @db.Date // Storing as pure date to avoid timezone weirdness
  status    String   // 'Perfect' | 'Saved' | 'Failed' | 'Frozen'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}
