generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  passwordHash   String
  coins          Int            @default(0)
  streakFreezes  Int            @default(0)
  currentStreak  Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  routineExercises RoutineExercise[]
  dailyLogs      DailyLog[]
}

model Exercise {
  id             String         @id @default(uuid())
  name           String
  type           String         // e.g., "counter", "timer"
  createdAt      DateTime       @default(now())
  routineExercises RoutineExercise[]
  dailyLogs      DailyLog[]
}

model RoutineExercise {
  id             String         @id @default(uuid())
  userId         String
  exerciseId     String
  targetMetrics  Json           // Expected targets, e.g., { "reps": 50 } or { "seconds_elapsed": 300 }
  createdAt      DateTime       @default(now())
  user           User           @relation(fields: [userId], references: [id])
  exercise       Exercise       @relation(fields: [exerciseId], references: [id])
}

model DailyLog {
  id             String         @id @default(uuid())
  userId         String
  exerciseId     String
  date           DateTime       // The date this log belongs to (considering night-owl timezone)
  status         String         // e.g., "completed", "partial", "failed", "frozen"
  metrics        Json           // The crucial JSONB column storing actual completion data, e.g. { "reps": 50 }
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id])
  exercise       Exercise       @relation(fields: [exerciseId], references: [id])
}
